<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SlimPaste Setup"
    Width="760"
    Height="760"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="NoResize"
    Background="#1E1E1E"
    Foreground="#F2F2F2"
    FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="PanelBg" Color="#242424"/>
        <SolidColorBrush x:Key="InputBg" Color="#303030"/>
        <SolidColorBrush x:Key="ButtonBg" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="Accent" Color="#4DA3FF"/>
        <SolidColorBrush x:Key="TextMain" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="TextMuted" Color="#BDBDBD"/>
        <SolidColorBrush x:Key="BorderMuted" Color="#3A3A3A"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMain}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource ButtonBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBg}" CornerRadius="18" BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="74"/>
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderPanel" Grid.Row="0" Background="#1E1E1E">
                <TextBlock Text="SlimPaste Setup"
                           FontSize="24"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="28,0,0,0"/>
                <Button x:Name="CloseButton"
                        Content="×"
                        Width="44"
                        Height="36"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0"
                        Background="{StaticResource ButtonBg}"
                        BorderBrush="Transparent"
                        FontSize="28"
                        Foreground="{StaticResource TextMuted}"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="34,6,34,26">

                    <TextBlock Text="Hotkey" FontSize="22" FontWeight="SemiBold" Margin="0,20,0,12"/>
                    <Border Background="{StaticResource PanelBg}" CornerRadius="14" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Dedicated paste hotkey" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                            <TextBox x:Name="HotkeyBox" Text="^!v"/>
                            <TextBlock x:Name="HotkeyReadable" Text="Hotkey is Ctrl + Alt + V" Foreground="{StaticResource Accent}" Margin="0,10,0,0"/>
                            <TextBlock x:Name="HotkeyError" Text="" Foreground="#FF6B6B" Margin="0,6,0,0" Visibility="Collapsed"/>
                            <TextBlock Text="^ = Ctrl    ! = Alt    + = Shift    # = Win"
                                       Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="JPEGli" FontSize="22" FontWeight="SemiBold" Margin="0,28,0,12"/>
                    <Border Background="{StaticResource PanelBg}" CornerRadius="14" Padding="18">
                        <StackPanel>
                            <CheckBox x:Name="UseJpegliCheck" Content="Use JPEGli (bundled)"/>
                            <TextBlock Text="Normal JPG files with better visual quality per byte."
                                       Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"/>
                            <TextBlock Text="Bundled at bin\jpegli\cjpegli.exe"
                                       Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Compression" FontSize="22" FontWeight="SemiBold" Margin="0,28,0,12"/>
                    <Border Background="{StaticResource PanelBg}" CornerRadius="14" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Output mode: JPG Quality" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                            <TextBlock Text="PNG Lossless: Coming soon" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"/>
                            <ComboBox x:Name="QualityPresetCombo" SelectedIndex="1">
                                <ComboBox.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource InputBg}"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource TextMain}"/>
                                </ComboBox.Resources>
                                <ComboBoxItem Content="Small 70" Tag="70"/>
                                <ComboBoxItem Content="Balanced 80" Tag="80"/>
                                <ComboBoxItem Content="High 90" Tag="90"/>
                                <ComboBoxItem Content="Near-lossless visual 95" Tag="95"/>
                            </ComboBox>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="QualitySlider" Grid.Column="0" Minimum="1" Maximum="100" Value="80" TickFrequency="1"/>
                                <TextBox x:Name="QualityBox" Grid.Column="2" Text="80"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Clipboard" FontSize="22" FontWeight="SemiBold" Margin="0,28,0,12"/>
                    <Border Background="{StaticResource PanelBg}" CornerRadius="14" Padding="18">
                        <StackPanel>
                            <CheckBox x:Name="ImageFallbackCheck" Content="Compatibility fallback"/>
                            <TextBlock Text="Also put image data on the clipboard for apps that dislike file paste."
                                       Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Temporary Files" FontSize="22" FontWeight="SemiBold" Margin="0,28,0,12"/>
                    <Border Background="{StaticResource PanelBg}" CornerRadius="14" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Temporary directory" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TempDirectoryBox" Grid.Column="0" Text="%TEMP%\SlimPaste"/>
                                <Button x:Name="SelectTempButton" Grid.Column="2" Content="Select"/>
                            </Grid>

                            <TextBlock Text="Cleanup days" Foreground="{StaticResource TextMuted}" Margin="0,14,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CleanupDaysBox" Grid.Column="0" Text="7"/>
                                <Button x:Name="OpenTempButton" Grid.Column="2" Content="Open temp folder"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Other" FontSize="22" FontWeight="SemiBold" Margin="0,28,0,12"/>
                    <Border Background="{StaticResource PanelBg}" CornerRadius="14" Padding="18">
                        <StackPanel>
                            <CheckBox x:Name="StartupCheck" Content="Startup with Windows"/>
                            <CheckBox x:Name="NotificationCheck" Content="Show notification after paste"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="About" FontSize="22" FontWeight="SemiBold" Margin="0,28,0,12"/>
                    <Border Background="{StaticResource PanelBg}" CornerRadius="14" Padding="18">
                        <StackPanel>
                            <TextBlock x:Name="AboutName" Text="SlimPaste" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AboutVersion" Text="" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                            <TextBlock Text="Clipboard image compressor — copy, paste, compressed."
                                       Foreground="{StaticResource TextMuted}" Margin="0,10,0,0"/>
                            <TextBlock Text="AutoHotkey v2 + PowerShell worker + JPEGli"
                                       Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="AboutCopyright" Text="MIT License" Foreground="{StaticResource TextMuted}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#1B1B1B" CornerRadius="0,0,18,18" BorderBrush="#303030" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0">
                    <Button x:Name="CancelButton" Content="Cancel" Width="110" Margin="0,0,12,0"/>
                    <Button x:Name="SaveButton" Content="Save" Width="110" Style="{StaticResource AccentButton}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
